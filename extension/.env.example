# Copy this file to .env (or export these directly in your shell) — never
# commit the real values. No automatic .env loading happens here; these are
# read by build.mjs at BUILD time (not runtime — there's no running
# process to read env vars from once this is an unpacked extension), so
# re-run `npm run build -w extension` whenever either changes.

# One of: development, twitch-local-test, closed-beta. Defaults to
# "development" if unset. Only "closed-beta" gates the manual session-ID
# field out of the debug panel in favor of the "Connect Twitch" flow — see
# src/background/link-state.ts and src/content/inventory.ts.
RIFTSIGHT_MODE=development

# The RiftSight backend's public origin (the same service as relay/ — see
# relay/.env.example) — used to open the OAuth linking flow
# (/auth/twitch/start) and poll link status (/api/link-status). Required
# for account linking to work in any mode other than development.
RIFTSIGHT_BACKEND_URL=http://localhost:8788
