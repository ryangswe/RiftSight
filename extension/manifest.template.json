{
  "manifest_version": 3,
  "name": "RiftSight",
  "version": "0.1.0",
  "description": "Publishes RiftAtlas card previews to your Twitch stream overlay.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RiftSight",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background/background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["ws://localhost/*", "http://localhost:8788/*"],
  "content_scripts": [
    {
      "matches": ["*://play.riftatlas.com/*"],
      "js": ["dist/content/inventory.js"],
      "run_at": "document_idle"
    }
  ]
}
