# Copy this file to .env (or export these directly in your shell) — never
# commit the real values. See README.md's "Twitch overlay" section for the
# full Local Test workflow these are used in.

# One of: development, twitch-local-test, closed-beta. Defaults to
# "development" if unset. closed-beta hard-fails startup if any secret
# listed in env.ts's REQUIRED_IN_CLOSED_BETA is missing, and always
# disables the unauthenticated local-debug path regardless of
# ALLOW_LOCAL_DEBUG below.
RIFTSIGHT_MODE=development

# Port the relay listens on. Defaults to 8787 if unset.
RELAY_PORT=8787

# A libsql client URL for persistent storage (broadcaster identity,
# closed-beta allowlist, producer credentials). Defaults to a local file
# under relay/data/ if unset. Use ":memory:" for ephemeral (test-only)
# storage, or a remote "libsql://..."/"https://..." URL to point at a
# hosted database instead of a local file.
RIFTSIGHT_DB_PATH=file:./data/riftsight.db

# Your Twitch Extension's client ID, from the Developer Console. Currently
# used for logging/diagnostics only — not used to validate anything.
TWITCH_EXTENSION_CLIENT_ID=

# Your Twitch Extension's shared secret, base64-encoded, from the
# Developer Console. Required before the relay will accept any
# twitch-subscribe — without it, that path is refused outright. This is
# the Extension shared secret, NOT your Twitch API Client Secret (a
# different credential) — relay-only, never put this in any frontend.
TWITCH_EXTENSION_SECRET=

# Set to "false" to disable the plain, unauthenticated `subscribe` path
# (used by the debug viewer and local-only testing). Defaults to enabled.
# Recommended "false" once this relay is reachable through a public
# tunnel — a tunneled relay is reachable by anyone with the URL, and the
# unauthenticated path becomes a real exposure, not just a local
# convenience.
ALLOW_LOCAL_DEBUG=true

# Twitch API app credentials for the "Log in with Twitch" OAuth flow used
# to identify a broadcaster during account linking (dev.twitch.tv, a
# SEPARATE app registration from your Twitch Extension above — these are
# your Twitch API Client ID/Secret, NOT the Extension's Client ID/shared
# secret). TWITCH_API_CLIENT_SECRET is relay-only, never put it in any
# frontend. Required in closed-beta mode.
TWITCH_API_CLIENT_ID=
TWITCH_API_CLIENT_SECRET=

# Must exactly match a redirect URI registered for the Twitch API app
# above. A plain http://localhost URI is fine in development (Twitch
# allows it for local testing); closed-beta mode requires https:.
TWITCH_OAUTH_REDIRECT_URI=http://localhost:8788/auth/twitch/callback
